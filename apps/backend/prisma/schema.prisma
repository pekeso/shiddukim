// Shiddukim — Plateforme de Gestion des Fidèles
// Prisma v7 schema — database URL is in prisma.config.ts (for migrations)
// and passed via PrismaPg adapter at runtime. Skeleton models expanded in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  SUPER_ADMIN
  CHURCH_ADMIN
  SECRETARY
  PASTOR
  COMMUNITY_LEADER
  MEMBER
}

enum MemberStatus {
  CREATED
  ACTIVATED
  SUSPENDED
  DECEASED
}

enum Gender {
  MALE
  FEMALE
}

enum VerificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum VerificationPurpose {
  MEMBER_ACTIVATION
  PASSWORD_RESET
  LOGIN_VERIFICATION
  SENSITIVE_ACTION
}

enum VerificationProvider {
  TWILIO
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum DocumentType {
  MEMBER_PHOTO
  MEMBER_CARD
  MARRIAGE_REQUEST_PDF
  MEDICAL_REFERRAL_PDF
  SUPPORTING_DOCUMENT
}

enum DocumentStatus {
  ACTIVE
  DELETED
}

enum DocumentVisibility {
  PRIVATE
  RESTRICTED
}

enum FileAccessAction {
  VIEW
  DOWNLOAD
  UPLOAD
  DELETE
  GENERATE
}

enum MarriageRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  WAITING_APPOINTMENT
  COUNSELING
  MEDICAL_REFERRAL
  WAITING_RESULTS
  APPROVED
  REJECTED
  COMPLETED
}

enum MarriageClassification {
  GREEN
  ORANGE
  RED
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  PASTORAL_COUNSELING
  MARRIAGE_REVIEW
  GENERAL
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationProvider {
  TWILIO
  SMTP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// A user account used for authentication.
// Separate from the church member record (see Member).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String

  status UserStatus @default(ACTIVE)
  role   Role       @default(MEMBER)

  // Refresh token rotation — only the hash is stored, never the raw token
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Linked member records (set during member activation)
  memberLinks UserMemberLink[]

  // Appointments where this user acts as the assigned pastor
  appointmentsAsPastor Appointment[] @relation("AppointmentPastor")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Member
// The official church identity record for a person.
// memberCode is the only public identifier — never expose `id` in API responses.
// baptismDate and baptizedBy are church-official fields; members cannot edit them.
// ─────────────────────────────────────────────────────────────────────────────

model Member {
  id         String @id @default(cuid())
  memberCode String @unique // e.g. SHK-2026-00001 — human-readable public code

  // Personal information
  firstName    String
  middleName   String?
  lastName     String
  gender       Gender?
  dateOfBirth  DateTime?
  placeOfBirth String?
  address      String?
  phone        String?
  email        String?

  // Photo — references the Document record for the member's profile photo.
  // Stores the internal Document.id (never returned to API clients).
  // Null means no photo has been uploaded yet.
  photoDocumentId String?

  // Community assignment
  communityId String?
  community   Community? @relation("CommunityMembers", fields: [communityId], references: [id])

  // Church / baptism data — only church officials can update these fields
  baptismDate DateTime?
  baptizedBy  String?

  status MemberStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userLinks          UserMemberLink[]
  ledCommunities     Community[]      @relation("CommunityPresident")
  marriageRequests   MarriageRequest[]
  appointments       Appointment[]

  // Indexes for search and duplicate detection
  @@index([lastName, firstName])
  @@index([email])
  @@index([phone])
  @@index([communityId])
  @@index([status])
  @@map("members")
}

// ─────────────────────────────────────────────────────────────────────────────
// Community
// A church sub-group (cell, choir, etc.) that members can be assigned to.
// presidentMemberId references the member who leads the community.
// ─────────────────────────────────────────────────────────────────────────────

model Community {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Optional: designate a member as president of this community
  presidentMemberId String?
  president         Member? @relation("CommunityPresident", fields: [presidentMemberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Members assigned to this community
  members Member[] @relation("CommunityMembers")

  @@map("communities")
}

// ─────────────────────────────────────────────────────────────────────────────
// UserMemberLink
// Links an authentication user account to an official church member record.
// Created during member activation (Phase 9).
// verifiedAt is set when the OTP verification confirms the link.
// ─────────────────────────────────────────────────────────────────────────────

model UserMemberLink {
  id       String @id @default(cuid())
  userId   String
  memberId String

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([userId, memberId])
  @@index([memberId])
  @@map("user_member_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog
// Immutable record of every significant action in the platform.
// actorUserId is nullable — system-initiated events (e.g. automated jobs) have
// no actor. entityId is stored as a string to accommodate any entity type.
// metadata holds structured context (IP is also promoted to its own column
// so it can be indexed / filtered without JSON extraction).
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String? // null for system-initiated events
  action      String // e.g. "auth.login", "member.created"
  entityType  String? // e.g. "User", "Member", "MarriageRequest"
  entityId    String? // public code or internal id (never exposed directly)
  metadata    Json? // arbitrary structured context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// OtpVerification
// Tracks every verification request sent via Twilio (or future providers).
// Raw OTP codes are NEVER stored — Twilio manages the code internally.
// The providerVerificationId (Twilio SID) is stored for correlation only.
// attempts is incremented on every failed verifyCode call.
// status transitions: PENDING → VERIFIED | EXPIRED | FAILED
// ─────────────────────────────────────────────────────────────────────────────

model OtpVerification {
  id String @id @default(cuid())

  // What kind of contact point is being verified (e.g. "email", "phone")
  targetType String

  // The actual contact point value (email address or phone number)
  targetValue String

  // Which provider sent the code
  provider VerificationProvider

  // Provider-specific verification ID for correlation (e.g. Twilio Verification SID)
  providerVerificationId String?

  // Channel used for delivery
  channel VerificationChannel

  // Why this verification was initiated
  purpose VerificationPurpose

  // Lifecycle status of this verification
  status OtpStatus @default(PENDING)

  // Number of failed verifyCode attempts — blocks further attempts at OTP_MAX_ATTEMPTS
  attempts Int @default(0)

  // When this verification record expires (set on creation from OTP_EXPIRES_IN_MINUTES)
  expiresAt DateTime

  // Set when the code is successfully verified
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  // Fast lookup by recipient + delivery context + status
  @@index([targetValue, channel, purpose, status])
  @@index([createdAt])
  @@map("otp_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Document
// Metadata record for every file stored in Cloudflare R2.
// The raw R2 object key is stored here and NEVER returned to API clients.
// Clients receive short-lived signed URLs via GET /documents/:documentCode/url.
//
// documentCode is the only public identifier — never expose `id` in responses.
// Soft delete: set status=DELETED and deletedAt; do not remove the DB record.
// Physical R2 deletion is deferred to a background retention policy.
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id           String @id @default(cuid())
  documentCode String @unique // e.g. DOC-2026-00001 — public identifier

  // What kind of entity owns this document
  ownerType String // e.g. "Member", "MarriageRequest"
  ownerId   String // internal DB id of the owning entity (not exposed publicly)

  // Classification
  documentType DocumentType
  visibility   DocumentVisibility @default(PRIVATE)
  status       DocumentStatus     @default(ACTIVE)

  // File metadata
  originalFileName String
  storedFileName   String // UUID-based name used in R2
  r2Bucket         String // Bucket name at time of upload (for future multi-bucket support)
  r2ObjectKey      String @unique // Full path in R2 — NEVER returned to API clients
  mimeType         String
  fileSize         Int // bytes
  checksum         String // hex SHA-256 computed before upload

  // Attribution
  uploadedByUserId  String? // who uploaded the file (null for generated docs)
  generatedByUserId String? // who triggered generation (null for user-uploaded docs)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // set on soft delete; null = active

  // Access log: every VIEW/DOWNLOAD/UPLOAD/DELETE/GENERATE is recorded here
  accessLogs FileAccessLog[]

  @@index([ownerType, ownerId])
  @@index([documentType])
  @@index([status])
  @@index([uploadedByUserId])
  @@index([createdAt])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// MarriageRequest
// A marriage case opened by a church member.
// requestCode is the only public identifier — never expose `id` in API responses.
// memberId references the requesting member (internal FK — not returned to clients).
// All status transitions are validated server-side via ALLOWED_TRANSITIONS.
// Pastoral notes and classification are restricted to pastoral staff.
// ─────────────────────────────────────────────────────────────────────────────

model MarriageRequest {
  id          String @id @default(cuid())
  requestCode String @unique // e.g. MAR-2026-00001 — public identifier

  // Requesting member — internal FK, never returned directly to API clients
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  // Spouse information (filled by the member before submission)
  spouseFullName       String?
  spousePhone          String?
  spouseEmail          String?
  intendedMarriageDate DateTime?

  // Workflow state
  status         MarriageRequestStatus  @default(DRAFT)
  classification MarriageClassification? // set by PASTOR; null until classified

  // Pastoral notes — only written by pastoral staff (marriage.review permission)
  pastorNotes String?

  // Workflow timestamps
  submittedAt DateTime? // set when status transitions from DRAFT → SUBMITTED
  reviewedAt  DateTime? // updated on every pastoral action (status/classification change)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([memberId])
  @@index([status])
  @@index([createdAt])
  @@map("marriage_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// FileAccessLog
// Immutable record of every sensitive file operation.
// Required by security rules: log every upload, view, download, delete, generate.
// actorUserId is nullable — system-generated access has no human actor.
// metadata captures request context (e.g. document code, signed URL expiry).
// ─────────────────────────────────────────────────────────────────────────────

model FileAccessLog {
  id String @id @default(cuid())

  documentId   String
  actorUserId  String? // null for system-initiated access
  action       FileAccessAction
  ipAddress    String?
  userAgent    String?
  accessedAt   DateTime         @default(now())
  metadata     Json? // structured context (never include raw R2 keys or signed URLs)

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([actorUserId])
  @@index([action])
  @@index([accessedAt])
  @@map("file_access_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Appointment
// Scheduled pastoral meeting between a member and a pastor.
// appointmentCode is the only public identifier (APT-YYYY-NNNNN).
// pastorId is a User.id of a user with PASTOR role (optional until assigned).
// marriageRequestId optionally links the appointment to an ongoing dossier.
// jobId24h / jobId1h hold BullMQ job IDs so reminders can be cancelled on
//   reschedule or cancellation.
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id              String @id @default(cuid())
  appointmentCode String @unique // e.g. APT-2026-00001 — public identifier

  // Requesting member
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  // Assigned pastor (optional — can be assigned later)
  pastorId String?
  pastor   User?   @relation("AppointmentPastor", fields: [pastorId], references: [id])

  // Linked marriage dossier (optional)
  marriageRequestId String?
  marriageRequest   MarriageRequest? @relation(fields: [marriageRequestId], references: [id])

  // Classification
  appointmentType AppointmentType
  status          AppointmentStatus @default(SCHEDULED)

  // Scheduling
  scheduledAt DateTime

  // Notes and cancellation
  notes        String?
  cancelReason String? // set when status → CANCELLED

  // BullMQ job IDs for reminder cancellation
  jobId24h String? // job ID for the 24h-before reminder
  jobId1h  String? // job ID for the 1h-before reminder

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([pastorId])
  @@index([marriageRequestId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// Record of every outbound notification (email / SMS / WhatsApp).
// Status tracks delivery lifecycle: PENDING → SENT | FAILED.
// errorMessage stores transport errors for debugging (never returned to clients).
// providerMessageId stores the SMTP message-id or Twilio SID for correlation.
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id              String @id @default(cuid())

  // Recipient — linked to the User receiving the notification
  recipientUserId String

  // Delivery metadata
  channel             NotificationChannel
  provider            NotificationProvider
  providerMessageId   String? // SMTP message-id or Twilio SID

  // Content
  subject String
  message String

  // Lifecycle
  status       NotificationStatus @default(PENDING)
  errorMessage String? // transport-level error (never exposed to clients)
  sentAt       DateTime? // set when status → SENT

  createdAt DateTime @default(now())

  @@index([recipientUserId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("notifications")
}
